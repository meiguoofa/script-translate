DATABASE_URL=sqlite+aiosqlite:///./data/app.db
STORAGE_ROOT=./storage
DEFAULT_PROVIDER=doubao
PROMPT_VERSION=v1
BATCH_SIZE=20

OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODELS=doubao-seed-1-6-flash-250715,doubao-seed-2-0-pro-260215
# 可在 .env 里继续用注释行补充豆包模型，系统会自动识别 #doubao-* 行
#doubao-seed-character-251128
TONGYI_API_KEY=
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Access passphrase: 前端调用花费较高的接口前需要带 X-Access-Passphrase 头
ACCESS_PASSPHRASE=change-me

# LAS (火山引擎 视频还原算子)
LAS_API_KEY=
LAS_BASE_URL=https://operator.las.cn-beijing.volces.com
LAS_OPERATOR_ID=las_short_drama_script_gen
LAS_OPERATOR_VERSION=v1
LAS_POLL_INTERVAL_SECONDS=10
LAS_POLL_TIMEOUT_SECONDS=10800

# TOS (火山引擎对象存储, S3 兼容)
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_BUCKET=test-short-drama
TOS_REGION=cn-beijing
TOS_S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
TOS_PUBLIC_ENDPOINT=tos-cn-beijing.volces.com
TOS_OUTPUT_PREFIX=output
TOS_UPLOAD_PREFIX=uploads

# 阿里云访问凭证（视频超分辨用，OSS + VIAPI 共用）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 阿里云 OSS（上海地域，视频超分辨桶）
ALIYUN_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_BUCKET=xzdl-video-super-resolution
ALIYUN_OSS_REGION=cn-shanghai
OSS_SUPER_RES_UPLOAD_PREFIX=super-resolution-input
OSS_SUPER_RES_OUTPUT_PREFIX=super-resolution-output

# 阿里云 VIAPI 视频超分辨
ALIYUN_VIAPI_ENDPOINT=videoenhan.cn-shanghai.aliyuncs.com
VIAPI_POLL_INTERVAL_SECONDS=10
VIAPI_POLL_TIMEOUT_SECONDS=10800
